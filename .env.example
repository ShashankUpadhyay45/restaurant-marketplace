# Environment Configuration for GourmetFleet Marketplace

# Server Ports & Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/gourmetfleet
REDIS_URL=redis://localhost:6379

# Security & Tokens (Change for production)
JWT_SECRET=gourmetfleet_super_secret_jwt_key_2026_dev_mode
JWT_REFRESH_SECRET=gourmetfleet_super_refresh_secret_2026_dev_mode
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway Sandbox (Mock or Real Razorpay / Stripe credentials)
PAYMENT_GATEWAY_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretValue987

# Notification Channels (Sandbox mode enabled by default)
EMAIL_PROVIDER=sandbox
WHATSAPP_PROVIDER=sandbox
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass

# Owner AI Assistant (Fallback to mock analysis engine if keys not provided)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
